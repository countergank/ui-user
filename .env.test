# Environment variables for the test environment (vitest, jsdom).
# Loaded via `import.meta.env` in unit/component tests. Keep values stable
# and non-environment-specific so tests are deterministic.
#
# VITE_API_BASE_URL must be non-empty here so the env module (src/lib/env.ts)
# resolves without fail-fast during tests. Use a stable placeholder that tests
# never actually hit — real API calls are mocked in component/integration tests.

VITE_API_BASE_URL=https://test.invalid

# Build mode for tests. Keep at "development" unless a test asserts staging/prod.
